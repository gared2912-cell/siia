---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { photo } from '../data/images';
import { site, waLink } from '../data/site';

const canales = [site.mostrarTelefonos && 'teléfono', site.mostrarWhatsapp && 'WhatsApp'].filter(Boolean);

// Formulario clasificado (Propuesta, sección F). Se omiten "Informes de compra" y "Vendedor" (venta de propiedades en pausa).
const reasons = ['Cotización de administración', 'Soy residente de un condominio SIIA', 'Soy proveedor', 'Otro'];
---

<Base
  title="Contacto"
  description={`Contacta a SIIA por ${canales.length ? `${canales.join(', ')} o ` : ''}correo. Cotizaciones, atención a residentes, proveedores y reportes urgentes de mantenimiento.`}
>
  <PageHero
    crumb="Contacto"
    title="Hablemos de tu condominio"
    lead={canales.length
      ? 'Escríbenos o llámanos. Te atendemos de forma personalizada por WhatsApp, llamada o correo.'
      : 'Escríbenos y te atendemos de forma personalizada por correo.'}
    image={photo('atencion-clientes')}
  />

  <section class="section">
    <div class="container contact">
      <div class="contact__info">
        <div class="grid info-cards">
          <a class="card info" href={`mailto:${site.email}`}>
            <div class="icon-badge"><Icon name="mail" /></div>
            <span>Correo electrónico</span>
            <strong>{site.email}</strong>
          </a>
          {
            site.mostrarWhatsapp && (
              <a class="card info" href={waLink('Hola SIIA, me gustaría recibir información.')} target="_blank" rel="noopener">
                <div class="icon-badge"><Icon name="whatsapp" /></div>
                <span>WhatsApp</span>
                <strong>Escríbenos</strong>
              </a>
            )
          }
        </div>

        {
          site.coverage && (
            <div class="card">
              <h2 class="h-small">Cobertura</h2>
              <p>{site.coverage.join(' · ')}</p>
            </div>
          )
        }
      </div>

      <form class="card form" data-lead-form data-subject="Tengo una consulta desde el sitio web" data-whatsapp={site.mostrarWhatsapp ? site.whatsapp : undefined}>
        <h2 class="h-small">Envíanos un mensaje</h2>
        <div class="field">
          <label for="motivo">Motivo de contacto *</label>
          <select id="motivo" name="motivo" required>
            <option value="" disabled selected>Selecciona una opción</option>
            {reasons.map((r) => <option>{r}</option>)}
          </select>
          <span class="error" aria-live="polite"></span>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="c-nombre">Nombre completo *</label>
            <input id="c-nombre" name="nombre" type="text" autocomplete="name" required />
            <span class="error" aria-live="polite"></span>
          </div>
          <div class="field">
            <label for="c-condominio">Condominio / empresa</label>
            <input id="c-condominio" name="condominio" type="text" autocomplete="organization" />
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="c-telefono">Teléfono / WhatsApp *</label>
            <input id="c-telefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" pattern="[0-9 +()-]{10,}" required />
            <span class="error" aria-live="polite"></span>
          </div>
          <div class="field">
            <label for="c-correo">Correo electrónico</label>
            <input id="c-correo" name="correo" type="email" autocomplete="email" />
            <span class="error" aria-live="polite"></span>
          </div>
        </div>
        <div class="field">
          <label for="c-mensaje">Mensaje *</label>
          <textarea id="c-mensaje" name="mensaje" required></textarea>
          <span class="error" aria-live="polite"></span>
        </div>
        <label class="consent">
          <input type="checkbox" name="consentimiento" required />
          <span>
            {site.mostrarAviso
              ? <>Acepto el <a href="/aviso-de-privacidad/" target="_blank">aviso de privacidad</a>.</>
              : 'Autorizo que SIIA use mis datos para responder mi mensaje.'}
          </span>
        </label>
        <button class="btn" type="submit">Enviar mensaje <Icon name="arrow" /></button>
        <p class="form-status" role="status" hidden data-status></p>
      </form>
    </div>
  </section>
</Base>

<script>
  import { initLeadForms } from '../scripts/lead-form';
  initLeadForms();
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 1000px) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    }
  }
  .contact__info {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    min-width: 0;
  }
  .info strong {
    overflow-wrap: anywhere;
  }
  .info-cards {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 16px;
  }
  .info {
    display: grid;
    gap: 2px;
    text-decoration: none;
    color: var(--ink);
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .info:hover {
    border-color: var(--mint);
    transform: translateY(-2px);
  }
  .info .icon-badge {
    margin-bottom: 10px;
    width: 48px;
    height: 48px;
  }
  .info span {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .info strong {
    font-family: var(--font-title);
    font-size: 1.15rem;
    color: var(--slate);
    overflow-wrap: anywhere;
  }
  .h-small {
    font-size: 1.4rem;
  }
  .form .btn {
    justify-self: start;
  }
</style>
