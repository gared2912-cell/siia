---
// Layout de las aplicaciones privadas (/portal y /admin): sin encabezado del sitio y nunca indexadas.
// Es una app instalable (manifest + service worker) con notificaciones push.
import '../styles/global.css';
import '../app/app.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} | SIIA</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#007c7d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icons/apple-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="SIIA" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <script is:inline>
      // El aviso de instalación de Android/Chrome llega una sola vez y muy pronto: se guarda para el botón «Instalar».
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        window.__siiaInstalar = e;
        window.dispatchEvent(new Event('siia-instalable'));
      });
      if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;600;700&family=Michroma&family=Mulish:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="app-body">
    <slot />
    <noscript><p class="app-noscript">Activa JavaScript para usar el portal.</p></noscript>
  </body>
</html>
