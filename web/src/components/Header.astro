---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<div class="topbar">
  <div class="container topbar__inner">
    <div class="topbar__contact">
      {
        site.phones.map((p) => (
          <a href={`tel:${p.tel}`}>
            <Icon name="phone" />
            {p.label}
          </a>
        ))
      }
      <a href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
    </div>
    {site.schedule && <span class="topbar__schedule"><Icon name="clock" />{site.schedule}</span>}
  </div>
</div>

<header class="header" data-header>
  <div class="container header__inner">
    <a href="/" class="brand" aria-label={`SIIA · ${site.fullName} · Inicio`}>
      <Logo />
    </a>

    <nav class="nav" aria-label="Principal" id="nav-principal" data-nav>
      <ul class="nav__list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="nav__link" aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav__actions">
        <a href="/portal-residentes/" class="btn btn--ghost btn--sm">
          <Icon name="user" />Acceso a residentes
        </a>
        <a href="/cotizar/" class="btn btn--sm">Cotizar administración</a>
      </div>
    </nav>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-principal" data-menu-toggle>
      <Icon name="menu" class="menu-toggle__open" />
      <Icon name="close" class="menu-toggle__close" />
      <span class="sr-only">Abrir menú</span>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('is-open', open);
    document.body.classList.toggle('no-scroll', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .topbar {
    background: var(--slate-dark);
    color: #d5d9e6;
    font-size: 0.88rem;
  }
  .topbar__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 40px;
  }
  .topbar__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
  }
  .topbar a,
  .topbar__schedule {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }
  .topbar a:hover {
    color: var(--mint);
  }
  .topbar :global(svg) {
    width: 15px;
    height: 15px;
    color: var(--mint);
  }
  @media (max-width: 640px) {
    .topbar {
      display: none;
    }
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Sin backdrop-filter: crearía un bloque contenedor y rompería el menú móvil (position: fixed) */
    background: #fff;
    border-bottom: 1px solid transparent;
    transition:
      box-shadow 0.2s,
      border-color 0.2s;
  }
  .header.is-scrolled {
    border-color: var(--line);
    box-shadow: 0 6px 20px -14px rgb(47 52 80 / 0.4);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    flex: none;
  }
  .brand :global(.logo-h) {
    --logo-h: 60px;
  }
  @media (min-width: 1400px) {
    .brand :global(.logo-h) {
      --logo-h: 66px;
    }
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .nav__list {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__link {
    display: block;
    padding: 10px 12px;
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 1.02rem;
    color: var(--slate);
    text-decoration: none;
    border-radius: 8px;
    position: relative;
  }
  .nav__link:hover {
    color: var(--teal-dark);
  }
  .nav__link[aria-current='page'] {
    color: var(--teal-dark);
  }
  .nav__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 4px;
    height: 3px;
    border-radius: 2px;
    background: var(--mint);
  }
  .nav__actions {
    display: flex;
    gap: 10px;
  }

  .menu-toggle {
    display: none;
    width: 48px;
    height: 48px;
    border: 1.5px solid var(--line);
    background: #fff;
    border-radius: 12px;
    color: var(--slate);
    cursor: pointer;
    place-items: center;
  }
  .menu-toggle :global(svg) {
    width: 24px;
    height: 24px;
  }
  .menu-toggle :global(.menu-toggle__close),
  .is-open .menu-toggle :global(.menu-toggle__open) {
    display: none;
  }
  .is-open .menu-toggle :global(.menu-toggle__close) {
    display: block;
  }

  @media (max-width: 1400px) {
    .nav {
      gap: 14px;
    }
  }

  @media (max-width: 520px) {
    .brand :global(.logo-h) {
      --logo-h: 52px;
    }
  }

  @media (max-width: 1180px) {
    .menu-toggle {
      display: grid;
    }
    .nav {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      height: calc(100dvh - var(--header-h));
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
      padding: 24px var(--gutter) 40px;
      background: #fff;
      overflow-y: auto;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 0.2s,
        transform 0.2s,
        visibility 0.2s;
    }
    .is-open .nav {
      visibility: visible;
      opacity: 1;
      transform: none;
    }
    .nav__list {
      flex-direction: column;
    }
    .nav__link {
      font-size: 1.3rem;
      padding: 14px 4px;
      border-bottom: 1px solid var(--line);
      border-radius: 0;
    }
    .nav__link[aria-current='page']::after {
      display: none;
    }
    .nav__actions {
      flex-direction: column;
    }
    .nav__actions .btn {
      min-height: 52px;
      font-size: 1.05rem;
    }
  }
  :global(body.no-scroll) {
    overflow: hidden;
  }
</style>
