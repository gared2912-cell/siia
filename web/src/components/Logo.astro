---
// Logotipo SIIA en SVG (nítido a cualquier tamaño), fiel a los originales de Siia/Logos.
// variant="horizontal": isotipo a la izquierda, SIIA a la derecha y la leyenda debajo a todo lo ancho (encabezado)
// variant="stacked":    isotipo arriba, SIIA y la leyenda centrados (portada, pie de página)
// tone="color": teal #38CBB9 + leyenda gris #989898, sobre fondo blanco · tone="white": todo blanco, sobre teal/gris/oscuro
import { layouts, logoInner, type LogoTone, type LogoVariant } from '../data/logo';

interface Props {
  variant?: LogoVariant;
  tone?: LogoTone;
  class?: string;
  title?: string;
}
const { variant = 'horizontal', tone = 'color', class: className, title = 'SIIA · soluciones inmobiliarias' } = Astro.props;
---

<svg
  class:list={['logo', `logo--${variant}`, className]}
  viewBox={layouts[variant].viewBox}
  role={title ? 'img' : undefined}
  aria-label={title || undefined}
  aria-hidden={title ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
  set:html={logoInner(variant, tone)}
/>

<style>
  .logo {
    display: block;
    height: auto;
  }
  .logo--stacked {
    width: 100%;
  }
  .logo--horizontal {
    --logo-h: 60px;
    height: var(--logo-h);
    width: auto;
    aspect-ratio: 1096.4 / 370.1;
  }
</style>
