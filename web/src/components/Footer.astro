---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, services, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo variant="stacked" tone="white" class="footer__logo" />
      <p>{site.slogan}</p>
      {site.repse && <p class="footer__badge">Empresa legalmente constituida · Registro REPSE</p>}
    </div>

    <div>
      <h2 class="footer__title">Navegación</h2>
      <ul class="footer__list">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/portal-residentes/">Acceso a residentes</a></li>
      </ul>
    </div>

    <div>
      <h2 class="footer__title">Servicios</h2>
      <ul class="footer__list">
        {services.map((s) => <li><a href={`/servicios/#${s.id}`}>{s.title}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="footer__title">Contacto</h2>
      <ul class="footer__list footer__contact">
        {
          site.phones.map((p) => (
            <li>
              <a href={`tel:${p.tel}`}>
                <Icon name="phone" />
                {p.label}
              </a>
            </li>
          ))
        }
        <li><a href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a></li>
        {site.address && <li><Icon name="pin" />{site.address}</li>}
        {site.schedule && <li><Icon name="clock" />{site.schedule}</li>}
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>© {year} {site.legalName}. Todos los derechos reservados.</p>
      <p>
        <a href="/aviso-de-privacidad/">Aviso de privacidad</a>
        <span aria-hidden="true">·</span>
        <a href="/terminos-y-condiciones/">Términos y condiciones</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--slate-dark);
    color: #c9cedd;
    font-size: 0.97rem;
  }
  .footer__grid {
    display: grid;
    gap: 40px;
    padding-block: 64px 48px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }
  @media (min-width: 1000px) {
    .footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
    }
  }
  .footer :global(.footer__logo) {
    width: 170px;
    margin-bottom: 18px;
  }
  .footer__brand p {
    max-width: 340px;
  }
  .footer__badge {
    display: inline-block;
    font-size: 0.85rem;
    padding: 6px 12px;
    border: 1px solid rgb(56 203 185 / 0.5);
    border-radius: 999px;
    color: var(--mint);
  }
  .footer__title {
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 16px;
  }
  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .footer a {
    color: inherit;
    text-decoration: none;
  }
  .footer a:hover {
    color: var(--mint);
    text-decoration: underline;
  }
  .footer__contact li,
  .footer__contact a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .footer__contact :global(svg) {
    width: 17px;
    height: 17px;
    color: var(--mint);
    flex: none;
  }
  .footer__bottom {
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.88rem;
  }
  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 20px;
  }
  .footer__bottom p {
    margin: 0;
  }
  .footer__bottom span {
    margin-inline: 8px;
  }
</style>
